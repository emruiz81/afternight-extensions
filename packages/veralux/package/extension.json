{
  "id": "veralux",
  "name": "VeraLux Suite",
  "version": "0.1.0",
  "summary": "VeraLux astrophotography post-processing suite ported from the original VeraLux scripts.",
  "description": "AfterNight port of the VeraLux suite, originally authored by Riccardo Paterniti. This source-staged package includes Revela local contrast enhancement, Alchemy linear narrowband normalization/mixing, HyperMetric Stretch nonlinear tone mapping, Curves photometric curve sculpting, Nox additive gradient reduction, Silentium linear noise suppression, Vectra LCH color grading, StarComposer star-mask shaping, and a package-local Starting Point workflow guide, with all VeraLux processes sharing one install, one dependency environment, and one requirements lock.",
  "author": "AfterNight contributors / Riccardo Paterniti",
  "license": "GPL-3.0-or-later",
  "publisher_id": "afternight",
  "attribution": "AfterNight port of the VeraLux suite, originally authored by Riccardo Paterniti.",
  "original_author": "Riccardo Paterniti",
  "original_project": "VeraLux",
  "original_source_url": "https://gitlab.com/free-astro/siril-scripts/-/tree/4ce0af52926e071caef55f4d17ac17ae8d8b4aac/VeraLux",
  "upstream_commit": "4ce0af52926e071caef55f4d17ac17ae8d8b4aac",
  "homepage_url": "https://gitlab.com/free-astro/siril-scripts/-/tree/main/VeraLux",
  "repository_url": "https://gitlab.com/free-astro/siril-scripts",
  "support_url": "https://github.com/emruiz81/afternight/issues",
  "type": "python",
  "entry_point": "veralux_extension",
  "category": "sharpening_enhancement",
  "launch_mode": "single_image",
  "sdk_backend": "runtime",
  "package_format_version": 1,
  "protocol_version": 1,
  "sdk_version": 1,
  "python_compat": ">=3.14,<4",
  "runtime_targets": [
    "linux-clang-x86_64",
    "windows-msvc-x86_64"
  ],
  "tags": [
    "VeraLux",
    "narrowband",
    "HOO",
    "curves",
    "stretch",
    "gradient",
    "background",
    "light-pollution",
    "stars",
    "denoise",
    "color",
    "LCH",
    "contrast",
    "texture",
    "ATWT",
    "workflow",
    "guide",
    "post-processing"
  ],
  "dependencies": {
    "dependency_context": "private",
    "requirements_file": "requirements.lock",
    "bundled_runtime_packages": [
      "numpy"
    ],
    "pip": {
      "require_hashes": true,
      "no_deps": true,
      "index_urls": [
        "https://pypi.org/simple"
      ]
    }
  },
  "processes": [
    {
      "id_suffix": "alchemy",
      "class": "VeraLuxAlchemyExtension",
      "display_name": "VeraLux Alchemy",
      "category": "color",
      "action_object_name": "actionVeraLux_Alchemy",
      "capabilities": {
        "execute": true,
        "preview": true,
        "keep_open": true
      }
    },
    {
      "id_suffix": "curves",
      "class": "VeraLuxCurvesExtension",
      "display_name": "VeraLux Curves",
      "category": "transforms",
      "action_object_name": "actionVeraLux_Curves",
      "capabilities": {
        "execute": true,
        "preview": true,
        "keep_open": true
      }
    },
    {
      "id_suffix": "hypermetric_stretch",
      "class": "VeraLuxHyperMetricStretchExtension",
      "display_name": "VeraLux HyperMetric Stretch",
      "category": "transforms",
      "action_object_name": "actionVeraLux_HyperMetric_Stretch",
      "capabilities": {
        "execute": true,
        "preview": true,
        "keep_open": true
      }
    },
    {
      "id_suffix": "nox",
      "class": "VeraLuxNoxExtension",
      "display_name": "VeraLux Nox",
      "category": "background_extraction",
      "action_object_name": "actionVeraLux_Nox"
    },
    {
      "id_suffix": "starcomposer",
      "class": "VeraLuxStarComposerExtension",
      "display_name": "VeraLux StarComposer",
      "category": "star_object",
      "action_object_name": "actionVeraLux_StarComposer"
    },
    {
      "id_suffix": "vectra",
      "class": "VeraLuxVectraExtension",
      "display_name": "VeraLux Vectra",
      "category": "color",
      "action_object_name": "actionVeraLux_Vectra"
    },
    {
      "id_suffix": "revela",
      "class": "VeraLuxRevelaExtension",
      "display_name": "VeraLux Revela",
      "category": "sharpening_enhancement",
      "action_object_name": "actionVeraLux_Revela",
      "capabilities": {
        "execute": true,
        "preview": true,
        "keep_open": true
      }
    },
    {
      "id_suffix": "silentium",
      "class": "VeraLuxSilentiumExtension",
      "display_name": "VeraLux Silentium",
      "category": "denoising",
      "action_object_name": "actionVeraLux_Silentium",
      "capabilities": {
        "execute": true,
        "preview": true,
        "keep_open": true
      }
    }
  ]
}
